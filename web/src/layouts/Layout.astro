---
import '@fontsource/inter';
import '@fontsource/outfit';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A premium academic platform" } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-background text-gray-100 font-sans antialiased overflow-x-hidden selection:bg-accent/30">
    <div class="fixed inset-0 z-[-1] bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"></div>
    <slot />
  </body>
</html>
